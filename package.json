{
  "name": "dsh-desktop",
  "version": "0.2.0",
  "description": "One-click DeepSeek Harness for Windows, with bundled Node.js and desktop app.",
  "main": "src/main.cjs",
  "author": "CuiLikun",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/check.cjs",
    "dist": "node scripts/build.cjs portable",
    "dist:nsis": "node scripts/build.cjs nsis",
    "dist:portable": "node scripts/build.cjs portable",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "test": "node --test test/*.test.cjs",
    "predist": "npm run prepare:runtime",
    "predist:nsis": "npm run prepare:runtime",
    "predist:portable": "npm run prepare:runtime",
    "test:runtime": "node scripts/smoke-service.cjs",
    "test:gui": "node scripts/run-gui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.cuilikun.dshdesktop",
    "productName": "DSH Desktop",
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "DSH-Installer-${version}-${arch}.${ext}"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "npmRebuild": false
  }
}
